compartment_ocid = "<COMPARTMENT_OCID>"
region           = "us-ashburn-1"

bucket_name    = "CriblOutput"
create_bucket  = true
object_prefix  = "cribl"
include_minute = true

# Build and push the image from Cloud Shell first, then paste the image URI.
function_image        = "<REGION_KEY>.ocir.io/<OBJECT_STORAGE_NAMESPACE>/cribl-oci-log-partitioner/function:0.0.1"
function_image_digest = ""

# Reuse an existing Functions app by default.
create_functions_application      = false
existing_functions_application_id = "<FUNCTIONS_APPLICATION_OCID>"

# If creating a new Functions app, set create_functions_application=true and provide subnets.
functions_subnet_ids = []

# Set false for an initial apply before log sources are known.
create_service_connector = true

log_sources = [
  {
    compartment_id = "<COMPARTMENT_OCID>"
    log_group_id   = "<LOG_GROUP_OCID>"
    log_id         = "<VCN_FLOW_LOG_OCID>"
    log_type       = "oci-vcn-flow"
  },
  {
    compartment_id = "<COMPARTMENT_OCID>"
    log_group_id   = "<LOG_GROUP_OCID>"
    log_id         = "<OBJECT_STORAGE_LOG_OCID>"
    log_type       = "oci-object-storage"
  }
]

connector_batch_size_in_num = 100
connector_batch_time_in_sec = 60

create_iam_resources = true
